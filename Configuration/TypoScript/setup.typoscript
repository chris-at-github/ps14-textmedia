// ---------------------------------------------------------------------------------------------------------------------
// tt_content Definition
tt_content {
	image =< lib.contentElement
	image {
		layoutRootPaths {
			200 = EXT:ps14_image/Resources/Private/Layouts/
			210 = EXT:ps14_site/Resources/Private/Extensions/Image/Layouts/
		}

		templateRootPaths {
			200 = EXT:ps14_image/Resources/Private/Templates/
			210 = EXT:ps14_site/Resources/Private/Extensions/Image/Templates/
		}

		partialRootPaths {
			200 = EXT:ps14_image/Resources/Private/Partials/
			210 = EXT:ps14_site/Resources/Private/Extensions/Image/Partials/
		}
	}
}

